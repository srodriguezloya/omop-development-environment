# PostgreSQL Configuration
POSTGRES_DB=ohdsi
POSTGRES_USER=ohdsi_admin
POSTGRES_PASSWORD=ohdsi
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# OMOP CDM Version
OMOP_CDM_VERSION=5.4

# Schema Configuration
DATASOURCE_CDM_SCHEMA=cdm
DATASOURCE_OHDSI_SCHEMA=ohdsi
DATASOURCE_COHORT_SCHEMA=ohdsi_results
DATASOURCE_RESULTS_SCHEMA=ohdsi_results

# JDBC Connection Template
JDBC_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# WebAPI Configuration
WEBAPI_URL=http://localhost:8080/WebAPI
DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
DATASOURCE_URL="${JDBC_URL}"

DATASOURCE_USERNAME="${POSTGRES_USER}"
DATASOURCE_PASSWORD="${POSTGRES_PASSWORD}"

# Flyway Configuration
FLYWAY_DATASOURCE_DRIVERCLASSNAME="${DATASOURCE_DRIVERCLASSNAME}"
FLYWAY_DATASOURCE_URL="${JDBC_URL}"
FLYWAY_SCHEMAS="${DATASOURCE_OHDSI_SCHEMA}"
FLYWAY_PLACEHOLDERS_OHDSISCHEMA="${DATASOURCE_OHDSI_SCHEMA}"

# Atlas Configuration
ATLAS_INSTANCE_NAME="OMOP Dev"
ATLAS_COHORT_COMPARISON_RESULTS_ENABLED=true
ATLAS_USER_AUTH_ENABLED=false

# Achilles Configuration
ACHILLES_DB_URI="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
ACHILLES_CDM_SCHEMA="${DATASOURCE_CDM_SCHEMA}"
ACHILLES_VOCAB_SCHEMA="${DATASOURCE_CDM_SCHEMA}"
ACHILLES_RESULTS_SCHEMA="${DATASOURCE_RESULTS_SCHEMA}"

# Development Settings
COMPOSE_PROJECT_NAME=omop
RELOAD_ON_CHANGE=true

# Sample Data Configuration
# Options: synthea, cms-synpuf, none
DEFAULT_SAMPLE_DATA=synthea

# Resource Limits (adjust based on your machine)
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_CONNECTIONS=100
