# PostgreSQL Configuration
POSTGRES_DB=ohdsi
POSTGRES_USER=ohdsi_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# OMOP CDM Version
OMOP_CDM_VERSION=5.4

# WebAPI Configuration
WEBAPI_URL=http://localhost:8080/WebAPI
DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
DATASOURCE_URL=jdbc:postgresql://postgres:5432/ohdsi
DATASOURCE_USERNAME=ohdsi_admin
DATASOURCE_PASSWORD=change_me_in_production
DATASOURCE_OHDSI_SCHEMA=ohdsi
DATASOURCE_CDM_SCHEMA=ohdsi
DATASOURCE_COHORT_SCHEMA=ohdsi

# Flyway Configuration - Critical Fix
FLYWAY_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
FLYWAY_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ohdsi
FLYWAY_DATASOURCE_USERNAME=ohdsi_admin
FLYWAY_DATASOURCE_PASSWORD=change_me_in_production
FLYWAY_SCHEMAS=webapi
FLYWAY_PLACEHOLDERS_OHDSISCHEMA=ohdsi

# Atlas Configuration
ATLAS_INSTANCE_NAME=OMOP Dev
ATLAS_COHORT_COMPARISON_RESULTS_ENABLED=true
ATLAS_USER_AUTH_ENABLED=false

# Achilles Configuration
ACHILLES_DB_URI=postgresql://ohdsi_admin:change_me_in_production@postgres:5432/ohdsi
ACHILLES_CDM_SCHEMA=ohdsi
ACHILLES_VOCAB_SCHEMA=ohdsi
ACHILLES_RESULTS_SCHEMA=ohdsi_results

# Development Settings
COMPOSE_PROJECT_NAME=omop
RELOAD_ON_CHANGE=true

# Sample Data Configuration
# Options: synthea, cms-synpuf, none
DEFAULT_SAMPLE_DATA=synthea

# Resource Limits (adjust based on your machine)
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_CONNECTIONS=100

